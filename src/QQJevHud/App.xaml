<Application x:Class="QQJevHud.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Color x:Key="CardBackgroundColor">#F0F4F5F7</Color>
    <Color x:Key="PrimaryTextColor">#FF1F2329</Color>
    <Color x:Key="SecondaryTextColor">#FF646A73</Color>
    <Color x:Key="BorderColor">#FFD9DCE1</Color>
    <Color x:Key="BrandColor">#FF3B82F6</Color>
    <Color x:Key="BarTrackColor">#FFE3E6EA</Color>
    <Color x:Key="BarFillMutedColor">#FF8B9098</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BarTrackBrush" Color="{StaticResource BarTrackColor}" />
    <SolidColorBrush x:Key="BarFillBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BarFillMutedBrush" Color="{StaticResource BarFillMutedColor}" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
  </Application.Resources>
</Application>
