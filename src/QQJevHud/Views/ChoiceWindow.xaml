<Window x:Class="QQJevHud.Views.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQ Jev HUD · 怎么回" Height="620" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF7F8FA" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <!-- One selectable reply; hover makes the "click me" affordance obvious. -->
        <Style x:Key="ChoiceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
                    <Setter Property="Background" Value="#FFF2F6FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scene: who said what, then Jev's read of it. -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="SpeakerLine" Text="对方" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource BrandBrush}" Margin="0,0,0,3"/>
                <TextBlock x:Name="MessageText" Text="（等待新消息…）" TextWrapping="Wrap"
                           FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,8"/>
                <StackPanel x:Name="JudgmentHost"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="重新生成" Click="RegenerateClick"/>
            <TextBlock x:Name="StatusLabel" Text="正在生成候选回复…"
                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Center" MaxWidth="270"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChoicesHost"/>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="点击任一选择即填入 QQ 输入框，不会自动发送 —— 确认后再点发送。"
                   Foreground="{StaticResource SecondaryTextBrush}"/>
    </Grid>
</Window>
