<Window x:Class="QQJevHud.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQ Jev HUD" Height="700" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF7F8FA" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero: name, one-line pitch, live status. -->
        <Border Grid.Row="0" Style="{StaticResource Panel}">
            <StackPanel>
                <TextBlock Text="QQ Jev HUD" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="在你聊天时，看懂对方这条消息是什么意思，并帮你想好几条可以直接发的回复。"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource BrandBrush}"/>
                    <TextBlock x:Name="StatusText" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}" Text="正在读取状态…"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="ToggleButton" Content="开始分析" Click="StartClick" MinWidth="110"/>
                    <Button Content="设置…" Click="SettingsClick"/>
                    <Button Content="关闭" Click="CloseClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="开始使用" Style="{StaticResource SectionHeader}"/>
                        <StackPanel x:Name="ChecklistHost"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="它能做什么" Style="{StaticResource SectionHeader}"/>
                        <StackPanel x:Name="FeaturesHost"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="先看看效果（不需要 QQ、不联网）" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="示例判断卡" Click="PreviewCardClick"/>
                            <Button Content="示例选择面板" Click="PreviewChoicesClick"/>
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="判断结果是概率性参考，不是事实，也不是心理评估。重要的事请用自己的判断。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="快捷键 Ctrl + Alt + J 暂停 / 恢复。关闭本窗口不会退出程序，它继续在托盘里运行。"/>
    </Grid>
</Window>
