<Window x:Class="QQJevHud.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QQJevHud.Views"
        Title="QQ Jev HUD Overlay" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Focusable="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <local:ProbabilityToWidthConverter x:Key="BarWidth" FullWidth="62" />
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.10" /></Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>
    <!-- One dimension row: label (★ when highlighted) plus its top two options with probability bars. -->
    <DataTemplate x:Key="DimensionTemplate" DataType="{x:Type local:DimensionRowViewModel}">
      <StackPanel Margin="0,0,0,5">
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}">
          <Run Text="{Binding Star, Mode=OneWay}" /><Run Text="{Binding Label, Mode=OneWay}" />
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Probability, StringFormat={}{0}%}" FontSize="11" TextAlignment="Right"
                           Margin="0,0,6,0" Foreground="{StaticResource SecondaryTextBrush}" />
                <Grid Grid.Column="2" Width="62" Height="6" VerticalAlignment="Center">
                  <Border Background="{StaticResource BarTrackBrush}" CornerRadius="3" />
                  <Border CornerRadius="3" HorizontalAlignment="Left"
                          Background="{Binding FillBrush}"
                          Width="{Binding Probability, Converter={StaticResource BarWidth}}" />
                </Grid>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <!-- One selectable reply: click to fill it into QQ (never sends). -->
    <DataTemplate x:Key="ChoiceTemplate" DataType="{x:Type local:ChoiceRowViewModel}">
      <Border x:Name="ChoiceRow" Margin="0,4,0,0" Padding="8,6" CornerRadius="6"
              Background="#FFF7F8FA" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
              Cursor="Hand" ToolTip="点击填入 QQ 输入框（不会自动发送）">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Index}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ToneName}" FontSize="11" Margin="6,0,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Text}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource PrimaryTextBrush}" />
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <TextBlock Text="{Binding OutcomeText}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RiskText}" FontSize="11" Margin="8,0,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="ChoiceRow" Property="IsMouseOver" Value="True">
          <Setter TargetName="ChoiceRow" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
          <Setter TargetName="ChoiceRow" Property="Background" Value="#FFF2F6FD" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Grid MouseLeftButtonUp="OnOverlayClick">
    <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="{x:Type ContentPresenter}">
          <Setter Property="Canvas.Left" Value="{Binding Left}" />
          <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:OverlayCardViewModel}">
          <Grid Width="{Binding Width}" Height="{Binding Height}">
            <Border Style="{StaticResource CardBorder}" Visibility="{Binding IsMarker, Converter={StaticResource InverseBoolToVisibility}}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Card.Topic, StringFormat=Jev · {0}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                <!-- Quoted message: identifies which message this card judges when the chat scrolls. -->
                <Border Grid.Row="1" Margin="0,6,0,0" Padding="8,5" CornerRadius="4"
                        Background="#FFF0F2F5" BorderThickness="3,0,0,0" BorderBrush="{StaticResource BorderBrush}"
                        Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock TextWrapping="Wrap" MaxHeight="36" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}">
                    <Run Text="{Binding SenderPrefix, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" /><Run Text="{Binding QuoteText, Mode=OneWay}" />
                  </TextBlock>
                </Border>
                <TextBlock Grid.Row="2" Margin="0,6,0,6" Text="{Binding Card.Question}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Card.Options}" Visibility="{Binding ShowPlainOptions, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,1">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Probability, StringFormat={}{0}%}" FontSize="12" TextAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Dimensions}" Visibility="{Binding ShowDimensions, Converter={StaticResource BoolToVisibility}}"
                              ItemTemplate="{StaticResource DimensionTemplate}" />
                <Grid Grid.Row="4" Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Card.RecommendedAction, StringFormat=建议：{0}}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Visibility="{Binding ShowAdvice, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Grid.Column="1" Text="{Binding RiskText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding RiskBrush}" Visibility="{Binding ShowRisk, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <!-- Expander: the replies live inside the card, so nothing floats separately. -->
                <Border x:Name="Expander" Grid.Row="5" Margin="0,8,0,0" Padding="0,6,0,0" BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource BorderBrush}" Cursor="Hand" ToolTip="点击展开候选回复">
                  <TextBlock Text="{Binding ExpandHint}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource BrandBrush}" />
                </Border>
                <ItemsControl Grid.Row="6" ItemsSource="{Binding ChoiceRows}" Visibility="{Binding ShowChoices, Converter={StaticResource BoolToVisibility}}"
                              ItemTemplate="{StaticResource ChoiceTemplate}" Margin="0,4,0,0" />
                <TextBlock Grid.Row="7" Margin="0,4,0,0" Text="{Binding StatusHint}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource BrandBrush}"
                           Visibility="{Binding HasStatusHint, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Border>
            <Border Width="18" Height="18" CornerRadius="9" Background="{Binding RiskBrush}" Visibility="{Binding IsMarker, Converter={StaticResource BoolToVisibility}}" ToolTip="Jev 判断已折叠" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
