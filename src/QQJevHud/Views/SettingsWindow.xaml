<Window x:Class="QQJevHud.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQ Jev HUD · 控制面板 / 设置" Height="720" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFF7F8FA" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="状态 / 控制" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="StatusText" Text="正在读取状态…" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartPauseButton" Content="暂停分析" Click="ToggleClick"/>
                            <Button Content="分析当前聊天" Click="AnalyzeClick"/>
                            <Button Content="重新校准聊天区域" Click="CalibrateClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="决策服务" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="ProviderTypeSafe" Content="Jev（TypeSafe）" GroupName="Provider" Checked="ProviderChanged" Margin="0,0,14,0"/>
                            <RadioButton x:Name="ProviderOpenAi" Content="OpenAI 兼容 LLM" GroupName="Provider" Checked="ProviderChanged" Margin="0,0,14,0"/>
                            <RadioButton x:Name="ProviderMock" Content="离线 Mock" GroupName="Provider" Checked="ProviderChanged"/>
                        </StackPanel>

                        <StackPanel x:Name="JevPanel">
                            <TextBlock Text="Jev API Key（只存入 Windows 凭据管理器，绝不进仓库）" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <PasswordBox x:Name="JevKey" Width="280" Margin="0,0,8,0"/>
                                <Button Content="保存 Key" Click="SaveJevKeyClick"/>
                                <Button Content="验证" Click="VerifyJevClick"/>
                            </StackPanel>
                            <TextBlock x:Name="JevKeyStatus" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <StackPanel x:Name="OpenAiPanel">
                            <TextBlock Text="Base URL（OpenAI 兼容端点，如 https://api.openai.com/v1）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="OpenAiBaseUrl" Margin="0,0,0,8"/>
                            <TextBlock Text="模型（如 gpt-4o-mini / deepseek-chat）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="OpenAiModel" Margin="0,0,0,8"/>
                            <TextBlock Text="API Key（只存入 Windows 凭据管理器，绝不进仓库）" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <PasswordBox x:Name="OpenAiKey" Width="280" Margin="0,0,8,0"/>
                                <Button Content="保存 Key" Click="SaveOpenAiKeyClick"/>
                                <Button Content="验证" Click="VerifyOpenAiClick"/>
                            </StackPanel>
                            <TextBlock x:Name="OpenAiKeyStatus" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="候选回复（话我帮你想，发送你来定）" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="GenerateRepliesToggle" Content="收到新消息时自动生成候选回复" Margin="0,0,0,8"/>
                        <TextBlock Text="启用的话术（逗号分隔，可多选）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TonesInput" Margin="0,0,0,8"/>
                        <TextBlock Text="自定义话术（格式：名字=说明|名字=说明）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CustomTonesInput" Margin="0,0,0,8" AcceptsReturn="True" Height="52" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="内置话术：高情商话术 / 自然接话 / 温柔体贴 / 稳如老狗 / 拒绝加班 / 卑微乙方 / 职场黑话 / 理科直男 / 阴阳怪气 / 已读乱回"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="关系模式" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ProfileGeneral" Content="通用（朋友 / 同事 / 群聊）" GroupName="Profile" Margin="0,0,14,0"/>
                            <RadioButton x:Name="ProfileRelationship" Content="亲密关系（情侣 / 夫妻）" GroupName="Profile"/>
                        </StackPanel>
                        <TextBlock Text="联系人背景卡：在项目根目录 notes/ 里放一个以联系人命名的 .md（如 notes/茶.md），写清约定、雷区和近况，保存即生效。"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="卡片显示" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="ShowIntent" Content="显示意图判断（概率分布）" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ShowRisk" Content="显示关系风险" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ShowAdvice" Content="显示回应建议" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ShowRecognitionFrameToggle" Content="用绿框标出正在识别的区域（关闭后不显示）" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="卡片透明度" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="CardOpacity" Width="200" Minimum="0.3" Maximum="1" ValueChanged="CardOpacityChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CardOpacityLabel" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="同屏最多几张" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="MaxCards" Width="80"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="隐私" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="RedactSensitive" Content="发送前脱敏敏感信息（转账 / 账号 / 密码 / 身份证）" Margin="0,0,0,6"/>
                        <TextBlock Text="截图与聊天正文只在内存中处理、从不落盘；诊断日志只记匿名状态码。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="通用" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="AutoStart" Content="开机自启" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="全局快捷键" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Ctrl + Alt + J（暂停 / 恢复）" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="查看诊断日志" Click="OpenLogClick" HorizontalAlignment="Left"/>
                        <TextBlock Text="QQ Jev HUD · 无侵入聊天意图 / 风险悬浮卡" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="保存" Click="SaveClick" MinWidth="96"/>
            <Button Content="取消" Click="CancelClick" MinWidth="96"/>
        </StackPanel>
    </Grid>
</Window>
